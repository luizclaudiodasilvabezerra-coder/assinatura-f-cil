{
  "name": "Documento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "numero": {
      "type": "string",
      "title": "N\u00famero do envelope"
    },
    "arquivos": {
      "type": "array",
      "title": "Arquivos",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "rascunho",
        "pendente",
        "assinado",
        "arquivado"
      ],
      "default": "pendente"
    },
    "pasta": {
      "type": "string",
      "title": "Pasta",
      "enum": [
        "pendente",
        "assinados"
      ],
      "default": "pendente"
    },
    "destinatario_nome": {
      "type": "string",
      "title": "Destinat\u00e1rio"
    },
    "destinatario_email": {
      "type": "string",
      "title": "E-mail do destinat\u00e1rio",
      "format": "email"
    },
    "signatario_nome": {
      "type": "string",
      "title": "Signat\u00e1rio"
    },
    "signatario_cadastro_id": {
      "type": "string",
      "title": "Cadastro do signat\u00e1rio"
    },
    "unidade_negocio": {
      "type": "string",
      "title": "Unidade de neg\u00f3cio"
    },
    "operacao": {
      "type": "string",
      "title": "Opera\u00e7\u00e3o"
    },
    "data_limite": {
      "type": "string",
      "title": "Data limite",
      "format": "date"
    }
  },
  "required": [
    "titulo"
  ]
}