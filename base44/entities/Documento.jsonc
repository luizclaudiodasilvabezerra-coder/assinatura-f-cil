{
  "name": "Documento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "numero": {
      "type": "string",
      "title": "N\u00famero do envelope"
    },
    "arquivos": {
      "type": "array",
      "title": "Arquivos",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "lotes": {
      "type": "array",
      "title": "Lotes do envelope",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome do lote"
          },
          "arquivos": {
            "type": "array",
            "title": "Arquivos do lote",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pendente_gestao",
        "assinado_gestao",
        "pendente_diretoria",
        "assinado_diretoria",
        "arquivado"
      ],
      "default": "pendente_gestao"
    },
    "pasta": {
      "type": "string",
      "title": "Pasta",
      "enum": [
        "pendente",
        "assinados"
      ],
      "default": "pendente"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "notas_boletos",
        "abastecimento"
      ],
      "default": "notas_boletos"
    },
    "destinatario_nome": {
      "type": "string",
      "title": "Destinat\u00e1rio"
    },
    "destinatario_email": {
      "type": "string",
      "title": "E-mail do destinat\u00e1rio",
      "format": "email"
    },
    "signatario_nome": {
      "type": "string",
      "title": "Signat\u00e1rio"
    },
    "signatario_email": {
      "type": "string",
      "title": "E-mail do signat\u00e1rio",
      "format": "email"
    },
    "signatario_cadastro_id": {
      "type": "string",
      "title": "Cadastro do signat\u00e1rio"
    },
    "diretoria": {
      "type": "string",
      "title": "Diretoria de destino"
    },
    "unidade_negocio": {
      "type": "string",
      "title": "Unidade de neg\u00f3cio"
    },
    "operacao": {
      "type": "string",
      "title": "Opera\u00e7\u00e3o"
    },
    "data_limite": {
      "type": "string",
      "title": "Data limite",
      "format": "date"
    },
    "processado": {
      "type": "boolean",
      "title": "Processado pelo fiscal",
      "default": false
    },
    "data_processamento": {
      "type": "string",
      "title": "Data e hor\u00e1rio do processamento",
      "format": "date-time"
    },
    "processado_por": {
      "type": "string",
      "title": "Respons\u00e1vel pela baixa"
    },
    "recusado": {
      "type": "boolean",
      "title": "NF recusada",
      "default": false
    },
    "observacao_recusa": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o da recusa"
    }
  },
  "required": [
    "titulo"
  ]
}