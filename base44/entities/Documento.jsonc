{
  "name": "Documento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "arquivos": {
      "type": "array",
      "title": "Arquivos",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "rascunho",
        "pendente",
        "assinado",
        "arquivado"
      ],
      "default": "pendente"
    },
    "pasta": {
      "type": "string",
      "title": "Pasta",
      "enum": [
        "recentes",
        "assinados"
      ],
      "default": "recentes"
    },
    "destinatario_nome": {
      "type": "string",
      "title": "Destinat\u00e1rio"
    },
    "destinatario_email": {
      "type": "string",
      "title": "E-mail do destinat\u00e1rio",
      "format": "email"
    },
    "data_limite": {
      "type": "string",
      "title": "Data limite",
      "format": "date"
    }
  },
  "required": [
    "titulo"
  ]
}