{
  "name": "Assinatura",
  "type": "object",
  "properties": {
    "documento_id": {
      "type": "string",
      "title": "Documento"
    },
    "documento_titulo": {
      "type": "string",
      "title": "T\u00edtulo do documento"
    },
    "arquivo_url": {
      "type": "string",
      "title": "Arquivo assinado",
      "format": "uri"
    },
    "assinante_nome": {
      "type": "string",
      "title": "Assinante"
    },
    "assinante_email": {
      "type": "string",
      "title": "E-mail do assinante",
      "format": "email"
    },
    "assinante_cadastro_id": {
      "type": "string",
      "title": "Cadastro do assinante"
    },
    "imagem_url": {
      "type": "string",
      "title": "Imagem da assinatura",
      "format": "uri"
    },
    "tipo": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "desenhada",
        "uploadada"
      ],
      "default": "desenhada"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "indent": {
      "type": "number",
      "title": "Recuo da observa\u00e7\u00e3o",
      "default": 0
    },
    "pos_x": {
      "type": "number",
      "title": "Posi\u00e7\u00e3o X (%)",
      "default": 10
    },
    "pos_y": {
      "type": "number",
      "title": "Posi\u00e7\u00e3o Y (%)",
      "default": 70
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pendente",
        "assinado",
        "rejeitado"
      ],
      "default": "assinado"
    },
    "data_assinatura": {
      "type": "string",
      "title": "Data da assinatura",
      "format": "date-time"
    }
  },
  "required": [
    "assinante_nome"
  ]
}