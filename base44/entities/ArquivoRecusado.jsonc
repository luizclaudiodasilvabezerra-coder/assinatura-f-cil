{
  "name": "ArquivoRecusado",
  "type": "object",
  "properties": {
    "documento_id": {
      "type": "string",
      "title": "Documento"
    },
    "documento_titulo": {
      "type": "string",
      "title": "T\u00edtulo do envelope"
    },
    "arquivo_url": {
      "type": "string",
      "title": "Arquivo recusado",
      "format": "uri"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o da recusa"
    },
    "gestor": {
      "type": "string",
      "title": "Gestor que recusou"
    },
    "data_recusa": {
      "type": "string",
      "title": "Data da recusa",
      "format": "date-time"
    }
  },
  "required": [
