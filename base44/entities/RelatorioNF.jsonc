{
  "name": "RelatorioNF",
  "type": "object",
  "properties": {
    "documento_id": {
      "type": "string",
      "title": "Documento"
    },
    "documento_titulo": {
      "type": "string",
      "title": "T\u00edtulo do envelope"
    },
    "arquivo_url": {
      "type": "string",
      "title": "Arquivo assinado",
      "format": "uri"
    },
    "emitente": {
      "type": "string",
      "title": "Emitente da NF"
    },
    "valor_total": {
      "type": "number",
      "title": "Valor total da NF",
      "default": 0
    },
    "data_emissao": {
      "type": "string",
      "title": "Data de emiss\u00e3o da NF",
      "format": "date"
    },
    "unidade_negocio": {
      "type": "string",
      "title": "Unidade de neg\u00f3cio"
    },
    "gestor": {
      "type": "string",
      "title": "Gestor"
    },
    "diretoria": {
      "type": "string",
      "title": "Diretoria"
    },
    "data_assinatura": {
      "type": "string",
      "title": "Data da assinatura",
      "format": "date-time"
    }
  },
  "required": [
    "documento_id",
    "arquivo_url"
  ]
}