{
  "description": "Envia e-mail de alerta ao fiscal \u00e0s 12:00 e 16:00 com envelopes assinados pendentes de processamento",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 12,16 * * *",
      "one_time_date": null,
