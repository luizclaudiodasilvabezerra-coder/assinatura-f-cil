      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Alerta Fiscal",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerta_fiscal",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_alerta": {
          "call": "invoke_backend_function",
